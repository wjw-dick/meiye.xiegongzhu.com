<view class="container">
  <view class="tabs">
    <view class="tab {{tab === '' ? 'on' : ''}}" data-tab="" bindtap="switchTab">全部</view>
    <view class="tab {{tab === 'PAID' ? 'on' : ''}}" data-tab="PAID" bindtap="switchTab">待核销</view>
    <view class="tab {{tab === 'VERIFIED' ? 'on' : ''}}" data-tab="VERIFIED" bindtap="switchTab">已核销</view>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无订单</view>
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="row between"><view class="bold small">{{item.orderNo}}</view><view class="pill">{{item.status}}</view></view>
    <view class="row between tiny muted" style="margin-top:8rpx">
      <text>{{item.createdAt}}</text><text class="price" style="font-size:30rpx">¥{{item.paidAmount || item.totalAmount}}</text>
    </view>
    <button wx:if="{{item.status === 'PAID'}}" class="btn sm" style="margin-top:14rpx" data-id="{{item.id}}" bindtap="verify">扫码核销</button>
  </view>
</view>
