<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无消息</view>
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="row between"><view class="bold small">{{item.title}}</view><view class="pill gray">{{item.channel || '站内'}}</view></view>
    <view class="small" style="margin-top:8rpx">{{item.content}}</view>
    <view class="tiny muted" style="margin-top:8rpx">{{item.sentAt || item.createdAt}}</view>
  </view>
</view>
