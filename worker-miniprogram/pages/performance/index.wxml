<view class="container">
  <view class="tabs">
    <view class="tab {{tab === 'perf' ? 'on' : ''}}" data-tab="perf" bindtap="switchTab">业绩</view>
    <view class="tab {{tab === 'schedule' ? 'on' : ''}}" data-tab="schedule" bindtap="switchTab">排班</view>
    <view class="tab {{tab === 'withdraw' ? 'on' : ''}}" data-tab="withdraw" bindtap="switchTab">提现</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:elif="{{tab === 'perf'}}">
    <view class="card" style="text-align:center;padding:40rpx">
      <view class="small muted">本月提成</view>
      <view style="font-size:64rpx;font-weight:800;color:#1f6f68">¥{{perf.month || 0}}</view>
      <view class="tiny muted">本月服务 {{perf.monthServices || 0}} 单 · 今日 {{perf.todayServices || 0}} 单</view>
    </view>
    <view class="card">
      <view class="kv"><text>今日提成</text><text class="bold">¥{{perf.today || 0}}</text></view>
      <view class="kv"><text>本周提成</text><text class="bold">¥{{perf.week || 0}}</text></view>
      <view class="kv"><text>累计提成</text><text class="price">¥{{perf.total || 0}}</text></view>
      <view class="kv"><text>累计提现</text><text>¥{{income.withdrawing || 0}}</text></view>
      <view class="kv"><text>可提现余额</text><text class="price">¥{{income.available || 0}}</text></view>
      <view class="kv"><text>客户评分</text><text>★ {{perf.reviews.avgScore || 0}}（{{perf.reviews.total || 0}} 条）</text></view>
    </view>
    <view class="sec-head"><view class="sec-title">结算明细</view></view>
    <view wx:if="{{!income.records.length}}" class="card muted small">暂无结算明细</view>
    <view class="card" wx:for="{{income.records}}" wx:key="id">
      <view class="row between"><view class="bold small">{{item.settlementNo}}</view><view class="pill">{{item.status}}</view></view>
      <view class="row between tiny" style="margin-top:6rpx">
        <text class="muted">{{item.startDate}} ~ {{item.endDate}}</text>
        <text>提成 <text class="price">¥{{item.commissionAmount}}</text></text>
      </view>
    </view>
  </block>

  <block wx:elif="{{tab === 'schedule'}}">
    <view wx:if="{{!schedules.length}}" class="empty">暂无排班</view>
    <view class="card" wx:for="{{schedules}}" wx:key="id">
      <view class="row between"><view class="bold small">{{item.workDate}}</view><view class="pill">{{item.status === 'WORK' ? '出勤' : '休息'}}</view></view>
      <view class="tiny" style="margin-top:6rpx">{{item.startTime}} - {{item.endTime}}</view>
      <view class="tiny muted">门店 #{{item.storeId}} · {{item.bizType || '全部品类'}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="bold" style="margin-bottom:16rpx">申请提现</view>
      <view class="field"><view class="field-label">提现金额（元）</view><input class="input" type="digit" value="{{amount}}" bindinput="onAmount" placeholder="请输入金额" /></view>
      <view class="field"><view class="field-label">备注</view><input class="input" value="{{remark}}" bindinput="onRemark" placeholder="可选" /></view>
      <button class="btn" disabled="{{busy}}" bindtap="withdraw">{{busy ? '提交中…' : '提交申请'}}</button>
    </view>
    <view class="sec-head"><view class="sec-title">提现记录</view></view>
    <view wx:if="{{!withdrawals.length}}" class="empty">暂无提现记录</view>
    <view class="card" wx:for="{{withdrawals}}" wx:key="id">
      <view class="row between"><view class="bold">¥{{item.amount}}</view><view class="pill">{{item.status}}</view></view>
      <view class="row between tiny muted" style="margin-top:6rpx"><text>手续费 ¥{{item.fee}} · 实得 ¥{{item.actualAmount}}</text><text>{{item.createdAt}}</text></view>
    </view>
  </block>
</view>
