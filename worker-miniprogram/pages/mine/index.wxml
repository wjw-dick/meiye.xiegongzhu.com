<view>
  <view class="hero">
    <view class="row">
      <view class="avatar">
        <image wx:if="{{tech.avatar}}" src="{{tech.avatar}}" style="width:100%;height:100%;border-radius:50%" mode="aspectFill" />
        <text wx:else>{{tech.name ? tech.name[0] : '技'}}</text>
      </view>
      <view style="margin-left:20rpx">
        <view class="hero-title">{{tech.name || '技师'}}</view>
        <view class="hero-sub">{{tech.position}} · {{tech.techNo}}</view>
      </view>
    </view>
    <view class="hero-stats">
      <view class="hero-stat"><view class="num">{{tech.serviceCount || 0}}</view><view class="label">服务次数</view></view>
      <view class="hero-stat"><view class="num">★ {{tech.rating || '-'}}</view><view class="label">评分</view></view>
      <view class="hero-stat"><view class="num">{{tech.certStatus || '-'}}</view><view class="label">证书状态</view></view>
    </view>
  </view>

  <view class="container" style="padding-top:24rpx">
    <view class="tabs">
      <view class="tab {{tab === 'menu' ? 'on' : ''}}" data-tab="menu" bindtap="setTab">我的服务</view>
      <view class="tab {{tab === 'cert' ? 'on' : ''}}" data-tab="cert" bindtap="setTab">证书</view>
      <view class="tab {{tab === 'review' ? 'on' : ''}}" data-tab="review" bindtap="setTab">评价</view>
    </view>

    <block wx:if="{{tab === 'menu'}}">
      <view class="card">
        <view class="kv"><text>所属门店</text><text>#{{tech.storeId}}</text></view>
        <view class="kv"><text>入职时间</text><text>{{tech.entryAt}}</text></view>
        <view class="kv"><text>擅长品类</text><text>{{tech.skills}}</text></view>
        <view class="kv"><text>个人简介</text><text>{{tech.bio || '-'}}</text></view>
      </view>
      <view class="menu-list">
        <view class="menu-item" data-url="/pages/performance/index?tab=schedule" bindtap="go"><view><text class="menu-icon">◷</text>我的排班</view><text>›</text></view>
        <view class="menu-item" data-url="/pages/performance/index" bindtap="go"><view><text class="menu-icon">↗</text>业绩提成</view><text>›</text></view>
        <view class="menu-item" data-url="/pages/logs/index" bindtap="go"><view><text class="menu-icon">✎</text>服务日志</view><text>›</text></view>
        <view class="menu-item" data-url="/pages/messages/index" bindtap="go"><view><text class="menu-icon">✉</text>消息中心</view><text>›</text></view>
        <view class="menu-item" data-url="/pages/password/index" bindtap="go"><view><text class="menu-icon">⚿</text>修改密码</view><text>›</text></view>
      </view>
      <view class="menu-list">
        <view class="menu-item" data-type="privacy" bindtap="showAgreement"><view><text class="menu-icon">◈</text>隐私政策</view><text>›</text></view>
        <view class="menu-item" data-type="service" bindtap="showAgreement"><view><text class="menu-icon">▤</text>技师服务规范</view><text>›</text></view>
      </view>
      <button class="btn gray" bindtap="logout">退出登录</button>
      <view class="tiny muted" style="text-align:center;margin-top:20rpx">门店编码 {{tenantCode}} · v1.0.0</view>
    </block>

    <block wx:elif="{{tab === 'cert'}}">
      <view wx:if="{{!certs.length}}" class="empty">暂无证书，请联系店长录入</view>
      <view class="card" wx:for="{{certs}}" wx:key="id">
        <view class="row between"><view class="bold">{{item.certType}}</view><view class="pill {{item.status === 'EXPIRED' ? 'red' : ''}}">{{item.status}}</view></view>
        <view class="tiny muted" style="margin-top:6rpx">证书编号 {{item.certNo}}</view>
        <view class="tiny muted">发证机构 {{item.issuer}}</view>
        <view class="tiny">有效期至 {{item.expireAt}}</view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{!reviews.length}}" class="empty">暂无客户评价</view>
      <view class="card" wx:for="{{reviews}}" wx:key="id">
        <view class="row between"><view style="color:#e0a13c">{{item.score}} 星</view><view class="tiny muted">{{item.createdAt}}</view></view>
        <view class="small" style="margin-top:6rpx">{{item.content}}</view>
        <view class="tiny" style="color:#1f6f68;margin-top:6rpx" wx:if="{{item.reply}}">门店回复：{{item.reply}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{agreements.show}}" class="mask" bindtap="closeAgreement">
    <view class="modal" catchtap="noop">
      <view class="bold" style="margin-bottom:16rpx">{{agreements.type === 'privacy' ? '隐私政策' : '技师服务规范'}}</view>
      <scroll-view scroll-y style="max-height:60vh"><text class="small" style="white-space:pre-wrap">{{agreements.content}}</text></scroll-view>
      <button class="btn" style="margin-top:24rpx" bindtap="closeAgreement">我知道了</button>
    </view>
  </view>
</view>
