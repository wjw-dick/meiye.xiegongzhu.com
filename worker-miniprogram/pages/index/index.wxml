<view>
  <view class="hero">
    <view class="row between">
      <view class="row">
        <view class="avatar">
          <image wx:if="{{tech.avatar}}" src="{{tech.avatar}}" style="width:100%;height:100%;border-radius:50%" mode="aspectFill" />
          <text wx:else>{{tech.name ? tech.name[0] : '技'}}</text>
        </view>
        <view style="margin-left:20rpx">
          <view class="hero-title">{{tech.name || '技师'}}</view>
          <view class="hero-sub">{{tech.position}} · {{tech.techNo}}</view>
        </view>
      </view>
      <view class="pill" style="background:rgba(255,255,255,.2);color:#fff">★ {{tech.rating || '-'}}</view>
    </view>
    <view class="hero-stats">
      <view class="hero-stat"><view class="num">{{dash.todayAppointments || 0}}</view><view class="label">今日预约</view></view>
      <view class="hero-stat"><view class="num">{{dash.servingCount || 0}}</view><view class="label">服务中</view></view>
      <view class="hero-stat"><view class="num">¥{{dash.monthCommission || 0}}</view><view class="label">本月提成</view></view>
    </view>
  </view>

  <view class="container" style="padding-top:0">
    <view class="card" style="margin-top:-60rpx;position:relative;z-index:2">
      <view class="row between" style="margin-bottom:18rpx">
        <view class="bold">快捷操作</view>
        <view class="tiny muted">可提现 ¥{{income.available || 0}}</view>
      </view>
      <view class="grid4">
        <view class="quick" wx:for="{{quick}}" wx:key="label" data-url="{{item.url}}" bindtap="go">
          <view class="quick-icon">{{item.icon}}</view><view>{{item.label}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <block wx:else>
      <view class="sec-head"><view class="sec-title">今日排班</view><view class="sec-more">共 {{profile.todaySchedules.length || 0}} 段</view></view>
      <view wx:if="{{!profile.todaySchedules.length}}" class="card muted small">今日暂无排班</view>
      <view class="card" wx:for="{{profile.todaySchedules}}" wx:key="id">
        <view class="row between"><view class="bold small">{{item.startTime}} - {{item.endTime}}</view><view class="pill">{{item.status === 'WORK' ? '出勤' : '休息'}}</view></view>
        <view class="tiny muted" style="margin-top:4rpx">门店 #{{item.storeId}} · {{item.bizType || '全部品类'}}</view>
      </view>

      <view class="sec-head"><view class="sec-title">收入概览</view><view class="sec-more" data-url="/pages/performance/index" bindtap="go">明细</view></view>
      <view class="card">
        <view class="kv"><text>累计提成</text><text class="price">¥{{income.totalCommission || 0}}</text></view>
        <view class="kv"><text>提现中/已提现</text><text>¥{{income.withdrawing || 0}}</text></view>
        <view class="kv"><text>可提现</text><text class="price">¥{{income.available || 0}}</text></view>
        <view class="kv"><text>服务次数</text><text>{{tech.serviceCount || 0}}</text></view>
      </view>
    </block>
  </view>
</view>
