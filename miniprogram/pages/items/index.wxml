<view class="container">
  <view class="tabs">
    <view class="tab {{tab === 'item' ? 'on' : ''}}" data-tab="item" bindtap="switchTab">服务项目</view>
    <view class="tab {{tab === 'package' ? 'on' : ''}}" data-tab="package" bindtap="switchTab">优惠套餐</view>
  </view>

  <block wx:if="{{tab === 'item'}}">
    <view class="chips">
      <view class="chip {{active === '' ? 'on' : ''}}" data-type="" bindtap="setType">全部</view>
      <view class="chip {{active === item ? 'on' : ''}}" wx:for="{{types}}" wx:key="*this" data-type="{{item}}" bindtap="setType">{{item}}</view>
    </view>
    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <view wx:elif="{{!filtered.length}}" class="empty">暂无可预约项目</view>
    <view class="item" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="goItem">
      <image wx:if="{{item.image}}" class="item-img" src="{{item.image}}" mode="aspectFill" />
      <view wx:else class="item-img"></view>
      <view class="item-main">
        <view class="row between"><view class="item-title">{{item.name}}</view><view class="pill">{{item.bizType}}</view></view>
        <view class="item-desc">{{item.description || item.category || '专业服务'}}</view>
        <view class="row between" style="margin-top:10rpx">
          <view class="price">¥{{item.price}}<text class="tiny muted"> / {{item.duration}}分钟</text></view>
          <view class="btn sm">预约</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!packages.length}}" class="empty">暂无套餐</view>
    <view class="card" wx:for="{{packages}}" wx:key="id" bindtap="book">
      <view class="row between">
        <view class="bold">{{item.name}}</view>
        <view class="pill">{{item.type === 'TIMES' ? '次卡' : '储值'}}</view>
      </view>
      <view class="small muted" style="margin:8rpx 0">{{item.description || '套餐详情以门店说明为准'}}</view>
      <view class="kv"><text>包含次数</text><text>{{item.times || '-'}}</text></view>
      <view class="kv"><text>有效期</text><text>{{item.validDays || '-'}} 天</text></view>
      <view class="row between" style="margin-top:14rpx">
        <view class="price">¥{{item.price}}</view>
        <view class="btn sm">立即购买</view>
      </view>
    </view>
  </block>
</view>
