<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!cards.length}}" class="empty">暂无会员卡</view>
  <block wx:else>
    <view class="card card-visual" wx:for="{{cards}}" wx:key="id">
      <view class="row between"><view class="bold">{{item.name}}</view><view class="pill">{{item.type === 'TIMES' ? '次卡' : '储值卡'}}</view></view>
      <view class="card-no">{{item.cardNo}}</view>
      <view class="row between" style="margin-top:24rpx">
        <view><view class="tiny" style="opacity:.75">余额</view><view style="font-size:34rpx;font-weight:700">¥{{item.balance}}</view></view>
        <view style="text-align:right"><view class="tiny" style="opacity:.75">剩余次数</view><view style="font-size:34rpx;font-weight:700">{{item.times || 0}}</view></view>
      </view>
      <view class="row between tiny" style="margin-top:16rpx;opacity:.8">
        <text>折扣 {{item.discount || 100}}%</text>
        <text>有效期至 {{item.expireAt}}</text>
      </view>
      <button class="btn ghost sm" style="margin-top:20rpx" data-index="{{index}}" bindtap="open">查看明细 / 充值</button>
    </view>
  </block>

  <view class="card" wx:if="{{active}}">
    <view class="row between"><view class="bold">充值 {{active.name}}</view><view class="tiny muted" bindtap="close">关闭</view></view>
    <view class="field" style="margin-top:20rpx">
      <view class="field-label">充值金额（元）</view>
      <input class="input" type="digit" value="{{amount}}" bindinput="onAmount" placeholder="如 1000" />
    </view>
    <button class="btn" disabled="{{busy}}" bindtap="recharge">{{busy ? '处理中…' : '确认充值'}}</button>
    <view class="sec-head"><view class="sec-title">消费明细</view></view>
    <view wx:if="{{!flows.length}}" class="small muted">暂无明细</view>
    <view class="kv" wx:for="{{flows}}" wx:key="id">
      <text>{{item.type}} · {{item.createdAt}}</text>
      <text style="color:{{item.amount >= 0 ? '#178a52' : '#c22f4a'}}">{{item.amount >= 0 ? '+' : ''}}{{item.amount}}</text>
    </view>
  </view>
</view>
