<view wx:if="{{loading}}" class="loading">加载中…</view>
<view wx:elif="{{error}}" class="empty">{{error}}</view>
<view wx:else>
  <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" style="width:100%;height:420rpx" />
  <view style="background:#fff;border-radius:32rpx 32rpx 0 0;margin-top:-30rpx;position:relative;padding:34rpx 30rpx 170rpx">
    <view class="row between">
      <view style="font-size:38rpx;font-weight:700">{{item.name}}</view>
      <view class="pill">{{item.bizType}}</view>
    </view>
    <view class="muted small" style="margin:12rpx 0 22rpx">{{item.description || '专业服务，具体以门店说明为准'}}</view>
    <view class="kv"><text>门店价</text><text class="price">¥{{item.price}}</text></view>
    <view class="kv" wx:if="{{item.memberPrice}}"><text>会员价</text><text>¥{{item.memberPrice}}</text></view>
    <view class="kv"><text>服务时长</text><text>{{item.duration}} 分钟</text></view>
    <view class="kv"><text>服务流程</text><text>咨询建档 → 专业服务 → 术后关怀</text></view>

    <view class="sec-head" wx:if="{{techs.length}}"><view class="sec-title">服务技师</view></view>
    <scroll-view scroll-x wx:if="{{techs.length}}">
      <view style="display:inline-flex">
        <view class="card" style="width:240rpx;margin-right:16rpx;text-align:center" wx:for="{{techs}}" wx:key="id">
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" style="width:88rpx;height:88rpx;border-radius:50%;margin:0 auto 8rpx" />
          <view class="bold small">{{item.name}}</view>
          <view class="tiny muted">{{item.position}}</view>
          <view class="tiny">★ {{item.rating}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="sec-head" wx:if="{{stores.length}}"><view class="sec-title">可服务门店</view></view>
    <view class="card" wx:for="{{stores}}" wx:key="id">
      <view class="bold small">{{item.name}}</view>
      <view class="tiny muted">{{item.address}}</view>
    </view>
  </view>
  <view class="float-btn"><button class="btn" bindtap="book">立即预约</button></view>
</view>
