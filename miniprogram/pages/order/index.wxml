<view class="container">
  <view class="tabs">
    <view class="tab {{tab === 'order' ? 'on' : ''}}" data-tab="order" bindtap="switchTab">订单</view>
    <view class="tab {{tab === 'review' ? 'on' : ''}}" data-tab="review" bindtap="switchTab">评价</view>
    <view class="tab {{tab === 'aftersale' ? 'on' : ''}}" data-tab="aftersale" bindtap="switchTab">售后</view>
  </view>

  <block wx:if="{{tab === 'order'}}">
    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <view wx:elif="{{!orders.length}}" class="empty">暂无订单</view>
    <view class="card" wx:for="{{orders}}" wx:key="id">
      <view class="row between">
        <view class="bold small">{{item.orderNo}}</view>
        <view class="pill">{{item.status}}</view>
      </view>
      <view class="row between tiny muted" style="margin-top:8rpx">
        <text>{{item.createdAt}}</text>
        <text class="price" style="font-size:30rpx">¥{{item.paidAmount || item.totalAmount}}</text>
      </view>
      <view wx:if="{{item.status === 'PAID' || item.status === 'VERIFIED'}}" class="code" data-text="{{item.orderNo}}" bindtap="copy">
        核销码：{{item.orderNo}}（点击复制）
      </view>
      <view class="row" style="margin-top:14rpx" wx:if="{{item.status === 'PENDING'}}">
        <button class="btn sm" data-id="{{item.id}}" bindtap="pay">立即支付</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{tab === 'review'}}">
    <view class="card">
      <view class="field">
        <view class="field-label">选择技师</view>
        <picker mode="selector" range="{{techs}}" range-key="name" value="{{techIndex}}" bindchange="onTech">
          <view class="picker"><text>{{techs[techIndex] ? techs[techIndex].name : '请选择'}}</text><text>›</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">评分</view>
        <view class="row">
          <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-score="{{item}}" bindtap="onScore" style="font-size:44rpx;margin-right:10rpx;color:{{item <= score ? '#f2b64c' : '#ddd'}}">★</view>
        </view>
      </view>
      <view class="field">
        <view class="field-label">评价内容</view>
        <textarea class="textarea" value="{{content}}" bindinput="onContent" placeholder="分享你的服务体验" />
      </view>
      <button class="btn" disabled="{{submitting}}" bindtap="submitReview">提交评价</button>
    </view>
    <view class="sec-head"><view class="sec-title">我的评价</view></view>
    <view wx:if="{{!reviews.length}}" class="empty">暂无评价</view>
    <view class="card" wx:for="{{reviews}}" wx:key="id">
      <view class="row between"><view style="color:#e0a13c">{{item.score}} 星</view><view class="tiny muted">{{item.createdAt}}</view></view>
      <view class="small" style="margin-top:8rpx">{{item.content}}</view>
      <view class="tiny" style="color:#b4235a;margin-top:6rpx" wx:if="{{item.reply}}">商家回复：{{item.reply}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="field">
        <view class="field-label">售后类型</view>
        <view class="chips" style="margin-bottom:0">
          <view class="chip {{asType === 'REFUND' ? 'on' : ''}}" data-type="REFUND" bindtap="onAsType">退款</view>
          <view class="chip {{asType === 'RERUN' ? 'on' : ''}}" data-type="RERUN" bindtap="onAsType">返工</view>
          <view class="chip {{asType === 'COMPLAINT' ? 'on' : ''}}" data-type="COMPLAINT" bindtap="onAsType">投诉</view>
        </view>
      </view>
      <view class="field">
        <view class="field-label">关联订单</view>
        <picker mode="selector" range="{{asOrders}}" range-key="orderNo" value="{{asOrderIndex}}" bindchange="onAsOrder">
          <view class="picker"><text>{{asOrders[asOrderIndex] ? asOrders[asOrderIndex].orderNo : '请选择订单'}}</text><text>›</text></view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">申请原因</view>
        <textarea class="textarea" value="{{asReason}}" bindinput="onAsReason" placeholder="请描述遇到的问题" />
      </view>
      <button class="btn" disabled="{{submitting}}" bindtap="submitAfterSale">提交申请</button>
    </view>
    <view class="sec-head"><view class="sec-title">售后记录</view></view>
    <view wx:if="{{!aftersales.length}}" class="empty">暂无售后记录</view>
    <view class="card" wx:for="{{aftersales}}" wx:key="id">
      <view class="row between"><view class="bold small">{{item.type}}</view><view class="pill">{{item.status}}</view></view>
      <view class="small" style="margin-top:8rpx">{{item.reason}}</view>
      <view class="tiny muted" style="margin-top:6rpx">{{item.createdAt}}</view>
      <view class="tiny" style="color:#b4235a;margin-top:6rpx" wx:if="{{item.result}}">处理结果：{{item.result}}</view>
    </view>
  </block>
</view>
