<view class="container">
  <view class="tabs">
    <view class="tab {{tab === 'book' ? 'on' : ''}}" data-tab="book" bindtap="switchTab">预约服务</view>
    <view class="tab {{tab === 'mine' ? 'on' : ''}}" data-tab="mine" bindtap="switchTab">我的预约</view>
  </view>

  <block wx:if="{{tab === 'book'}}">
    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <block wx:else>
      <view class="card">
        <view class="field">
          <view class="field-label">选择项目</view>
          <picker mode="selector" range="{{items}}" range-key="name" value="{{itemIndex}}" bindchange="onItem">
            <view class="picker"><text>{{items[itemIndex].name}}</text><text>›</text></view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">选择门店</view>
          <picker mode="selector" range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="onStore">
            <view class="picker"><text>{{stores[storeIndex].name}}</text><text>›</text></view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">选择技师（可选）</view>
          <picker mode="selector" range="{{techs}}" range-key="name" value="{{techIndex}}" bindchange="onTech">
            <view class="picker"><text>{{techs[techIndex] ? techs[techIndex].name : '由门店安排'}}</text><text>›</text></view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">选择日期</view>
          <picker mode="date" value="{{date}}" start="{{today}}" bindchange="onDate">
            <view class="picker"><text>{{date}}</text><text>›</text></view>
          </picker>
        </view>
      </view>

      <view class="card">
        <view class="field-label">可预约时段</view>
        <view wx:if="{{!slots.length}}" class="small muted" style="padding:16rpx 0">当日暂无可约时段，请更换日期或门店。</view>
        <view class="chips">
          <view class="chip {{slot && slot.time === item.time && slot.technicianId === item.technicianId ? 'on' : ''}}" wx:for="{{slots}}" wx:key="index" data-index="{{index}}" bindtap="onSlot">
            {{item.time}} · {{item.technicianName}}
          </view>
        </view>
      </view>

      <view class="card">
        <view class="field">
          <view class="field-label">备注</view>
          <textarea class="textarea" value="{{remark}}" bindinput="onRemark" placeholder="过敏史、偏好或其他需求" />
        </view>
        <view class="row between" style="padding:6rpx 0 18rpx">
          <view class="small">同时在线支付项目费用 ¥{{items[itemIndex].price}}</view>
          <switch checked="{{payNow}}" color="#b4235a" bindchange="onPay" />
        </view>
        <button class="btn" disabled="{{submitting || !slot}}" bindtap="submit">{{submitting ? '提交中…' : (slot ? '确认预约' : '请选择时段')}}</button>
      </view>
    </block>
  </block>

  <block wx:else>
    <view wx:if="{{apptLoading}}" class="loading">加载中…</view>
    <view wx:elif="{{!appointments.length}}" class="empty">暂无预约记录</view>
    <view class="card" wx:for="{{appointments}}" wx:key="id">
      <view class="row between">
        <view class="bold small">{{item.startTime}}</view>
        <view class="pill">{{item.status}}</view>
      </view>
      <view class="tiny muted" style="margin-top:6rpx">预约号 {{item.appointmentNo}}</view>
      <view class="row between tiny" style="margin-top:10rpx">
        <text>门店 #{{item.storeId}} · 技师 #{{item.technicianId || '-'}}</text>
        <text class="price">¥{{item.amount}}</text>
      </view>
      <view class="tiny muted" style="margin-top:6rpx" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
      <view class="row" style="margin-top:14rpx" wx:if="{{item.status === 'PENDING' || item.status === 'CONFIRMED'}}">
        <button class="btn ghost sm" data-id="{{item.id}}" bindtap="cancel">取消预约</button>
      </view>
    </view>
  </block>
</view>
