.tabbar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; display: flex; background: rgba(255,255,255,.98); border-top: 1rpx solid #f0e8ee; padding-bottom: env(safe-area-inset-bottom); }
.tab { flex: 1; text-align: center; padding: 12rpx 0 10rpx; color: #948a98; font-size: 20rpx; }
.tab .icon { font-size: 38rpx; line-height: 1.2; }
.tab.active { color: #b4235a; font-weight: 600; }
