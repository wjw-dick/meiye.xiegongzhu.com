# ============================================================
# 美业大健康数字化平台 · 生产环境变量模板
# 复制到 /etc/meiye/meiye.env，权限 600，属主 meiye:meiye
# 所有 CHANGE_ME 必须替换；生产禁止使用演示密码
# ============================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# ---------- MySQL 8 ----------
DB_HOST=127.0.0.1
MYSQL_PORT=3306
DB_NAME=meiye
DB_USER=meiye
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- RabbitMQ ----------
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=meiye
RABBIT_PASSWORD=CHANGE_ME_RABBIT_PASSWORD
RABBIT_VHOST=/meiye

# ---------- MinIO / 对象存储 ----------
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_USER=meiye
MINIO_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=meiye
# 本地存储驱动时使用（STORAGE_DRIVER=LOCAL）
STORAGE_LOCAL_DIR=/opt/meiye/data/uploads
STORAGE_PUBLIC_BASE=https://api.example.com/api/files

# ---------- 安全密钥 ----------
# JWT 至少 32 字节随机串：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE_HOURS=24
# 敏感字段 AES 密钥，必须 16/24/32 字节；上线后不可随意变更
# openssl rand -base64 24
DATA_AES_KEY=CHANGE_ME_24_BYTE_AES_KEY

# ---------- 微信 ----------
# 未取得正式资质前置 true（使用 mock），上线切换 false
WECHAT_MOCK=true

# ---------- 运行目录 ----------
APP_HOME=/opt/meiye
LOG_FILE=/opt/meiye/data/logs/meiye.log
BACKUP_DIR=/opt/meiye/data/backup

# ---------- 备份 ----------
BACKUP_KEEP_DAYS=7
MYSQL_BACKUP_USER=meiye
MYSQL_BACKUP_PASSWORD=CHANGE_ME_DB_PASSWORD
